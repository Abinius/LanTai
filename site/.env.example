APP_NAME="兰台观局"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# 本地开发用 SQLite；生产部署改 mysql（对齐 Signify，见 PRD §2 零 Docker）
DB_CONNECTION=sqlite
# DB_DATABASE 留空 → Laravel 默认 database_path('database.sqlite')
# 生产 MySQL 示例：
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laotai
# DB_USERNAME=laotai
# DB_PASSWORD=

MAIL_MAILER=log
MAIL_FROM_ADDRESS=intelligence@lantai.local
MAIL_FROM_NAME="${APP_NAME}"

BROADCAST_DRIVER=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# 内核产物目录（绝对路径）。留空默认 ../pipeline/data
LANTAI_DATA_DIR=

# 品牌
LANTAI_BRAND="兰台观局"
LANTAI_DISTRIBUTOR="松山高参"
LANTAI_SLOGAN="兰台之上，静观天下局"
LANTAI_FOOTER="兰台观局 出品 · 松山高参 分发"
LANTAI_PER_PAGE=12
