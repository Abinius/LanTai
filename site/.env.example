APP_NAME="兰台观局"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# 本地开发用 SQLite；生产部署改 mysql（对齐 Signify，见 PRD §2 零 Docker）
DB_CONNECTION=sqlite
# DB_DATABASE 留空 → Laravel 默认 database_path('database.sqlite')
# 生产 MySQL 示例：
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=lantai
# DB_USERNAME=lantai
# DB_PASSWORD=

MAIL_MAILER=log
# VPS 生产环境改 smtp 并配齐下面几行；本地开发保持 log（邮件走 log channel，不发网络）
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=noreply@lantai.local
# MAIL_PASSWORD=your-smtp-password
# MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=intelligence@lantai.local
MAIL_FROM_NAME="${APP_NAME}"

BROADCAST_DRIVER=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# 内核产物目录（绝对路径）。留空默认 ../pipeline/data
LANTAI_DATA_DIR=

# 品牌
LANTAI_BRAND="兰台观局"
LANTAI_DISTRIBUTOR="松山高参"
LANTAI_SLOGAN="兰台之上，静观天下局"
# 情报后台白名单（逗号分隔多个邮箱）；留空则 /admin/* 对所有人 403
LANTAI_ADMIN_EMAILS=
LANTAI_FOOTER="兰台观局 出品 · 松山高参 分发"
LANTAI_PER_PAGE=12
LANTAI_LEDGER_PREVIEW=60
LANTAI_OG_IMAGE="android-chrome-512x512.png"

# 内核 LLM 配置（pipeline/ 读取；留空用 sensenova 默认）
LANTAI_LLM_BASE_URL=https://token.sensenova.cn/v1/chat/completions
LANTAI_LLM_MODEL=sensenova-6.8-flash-lite
