# 密钥与本地配置（绝不入库）
.env
.env.*
!.env.example
llm key.txt
*.key
*.pem
secrets/

# 数据与备份（二进制大文件，不进版本库）
.data/
backup/
data/
database/*.sqlite
database/*.sqlite-journal
database/*.sqlite-shm
database/*.sqlite-wal
*.dump
*.sql.gz
*.tar.gz
*.zip

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
